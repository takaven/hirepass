# HirePass environment template
# Copy to .env for local/disposable development. Never commit real values.

# --- Database ---
DATABASE_URL=

# --- Admin authentication ---
HIREPASS_ADMIN_USERNAME=

# Production must use HIREPASS_ADMIN_PASSWORD_HASH.
# Local/disposable development may use either HIREPASS_ADMIN_PASSWORD or HIREPASS_ADMIN_PASSWORD_HASH.
HIREPASS_ADMIN_PASSWORD=
HIREPASS_ADMIN_PASSWORD_HASH=

# Strong secret, minimum 32 characters.
HIREPASS_SESSION_SECRET=

# Optional separate HMAC secret for database-backed abuse counters; session secret is used when unset.
HIREPASS_RATE_LIMIT_SECRET=
# Set only to the exact number of trusted reverse proxies in front of HirePass (0-5).
HIREPASS_TRUST_PROXY_HOPS=0

# --- Upload storage ---
# Must point to an existing readable/writable persistent directory in production.
HIREPASS_UPLOAD_DIR=

# --- Public candidate intake ---
HIREPASS_COMPANY_NAME=
# Optional display values used on public intake and the read-only deployment configuration page.
HIREPASS_COMPANY_LOCATION=
HIREPASS_CAREERS_CONTACT_EMAIL=
HIREPASS_PRIVACY_NOTICE_URL=
# Customer-controlled identifier updated whenever the notice changes.
HIREPASS_PRIVACY_NOTICE_VERSION=

# --- Pass identity ---
# Optional; defaults to HP when unset.
HIREPASS_PASS_ID_PREFIX=HP

# --- AI-assisted review launch capability ---
# Core HirePass must still run if AI is disabled or unavailable.
# Enable only after provider/privacy approval.
HIREPASS_AI_ENABLED=false
ANTHROPIC_API_KEY=
HIREPASS_AI_MODEL=claude-sonnet-5
HIREPASS_AI_MAX_BATCH=25
HIREPASS_AI_TIMEOUT_MS=30000

# --- Transactional email ---
# Deployment-level only. Hiring users do not configure provider details in-product.
HIREPASS_EMAIL_ENABLED=false
HIREPASS_EMAIL_FROM=
HIREPASS_SMTP_HOST=
HIREPASS_SMTP_PORT=587
HIREPASS_SMTP_SECURE=false
HIREPASS_SMTP_USER=
HIREPASS_SMTP_PASSWORD=
